# path: print entries in $PATH
path() {
    print ${(F)path}
}

# lsop: list all executables in $PATH directories
lsop() {
    case "$#" in
        0) print -l ${commands:t} | sort -i ;;
        *) print -l ${commands:t} | sort -i | command grep -i "$@" ;;
    esac
}
# bak: backup stdin
bak() {
    # creates a backup file from stdin
    for i do
        if [ -f "$i" ]
        then
            case ${i##*/} in
                (?*.?*)
                    print "file extension found: ${i##*.}"
                    print "bare file: ${i%.*}"
                    cp -iv -- "$i" "${i%.*}.bak.${i##*.}"
                ;;
                (*) cp -iv -- "$i" "$i.bak"
            esac
        else
            print "invalid file: $i"
        fi
    done
}
# sp_ce: replace spaces in filenames with _
sp_ce() {
    for f in *\ *; do mv "$f" "${f// /_}"; done
}
# sp-ce: replace spaces in filenames with -
sp-ce() {
    for f in *\ *; do mv "$f" "${f// /-}"; done
}
# my_ps: view processes started by current user
my_ps() {
    # get processes the user started
    ps $@ -u $USER -o pid,%cpu,%mem,bsdtime,command
}
# pp: pick process from my_ps function
pp() {
    # pick a process from my_ps
    my_ps f | awk '!/awk/ && $0~var' var=${1:-".*"}
}
# targz: create archive from stdin
targz() {
    # create targz archive from stdin
    tar cvzf "${1%%/}.tar.gz"  "${1%%/}/"
}
