# web: compile percipia website, kill and restart running process
web() {
	local full_dir=$PWD
	local base_dir=${PWD:t}
	if [[ "$base_dir" != "percipia_website" ]]; then
		print "Tried to build website from wrong location, must be in percipia_website directory to execute this function!\n"
		print "Full working directory: $full_dir"
		print "Current base directory: $base_dir\n"
		return 1
	fi
	# restart website
    print "rebuilding and executing web server"
    print "log: ./percipia_site.log"
	if pgrep -f 'percipia' &>/dev/null
    then
        print "killing current web server instance"
        pkill percipia
    else
        print "web server not running, moving to compile"
    fi
	# build and run command
	{ make && ./percipia &> percipia_site.log & }
}


# t: tail multiple files
t() {
    case "$#" in
        0)
            print "Must provide file name(s) to follow tail! Try again!"
            return 1
        ;;
        1)
            tail -n "$LINES" -f "$@"
            return 0
        ;;
        <2-100>) # zsh decimal match up to 100 files
            local var filestack=()
            for var in "$@"
            do
                if [[ -f "$var" ]]
                then
                    print "Adding to stack: $var"
                    filestack+=("$var")
                else
                    print "Skipping non-file: $var"
                fi
            done
            tail -n $LINES -f $filestack
            return 0
        ;;
    esac
}

# nn: connect to node in new window
# get max window index in current session
nn() {
    maxwin=$(tmux list-windows -F \#I | tail -n1)
    next=$((maxwin+1))
    window=$(tmux new-window -n "n${1}" -t "$next" -d -P)
    tmux send-keys -t "$window" "ssh root@frequency.node${1}" C-m
    tmux send-keys -t "$window" "zsh" C-m
    tmux send-keys -t "$window" "clear" C-m
    sleep 0.5
    tmux select-window -t "$window"
    sleep 0.3
    tmux send-keys -t "$window" "echo You are now connected to frequency.node${1}!" C-m
}

# rnf: rename file, appending date in format +%Y%m%d before extension (if exist)
# if no file extension, then append _%Y%m%d to end of file
rnf() {
    if [[ ! -f "$1" ]]; then
        print "Must provide filename as argument!"
        return 1
    fi
    zmodload -F zsh/stat b:zstat
    local i date
    for i do
        if ! date=$(zstat -F %Y%m%d +mtime -- "$i"); then
            print "Unable to parse date from file: $i"
            return 1
        fi
        case ${i##*/} in
            (?*.?*) # matches containing file extension
                mv -iv -- "$i" "${i%.*}_${date}.${i##*.}"
            ;;
            (*) mv -iv -- "$i" "${i}_${date}"
        esac
    done
}

# fsreload: Purge FusionPBX cache then reload FreeSWITCH XML/ACL
fsreload() {
    cachedir="/var/cache/fusionpbx"

    cachecount=$(find "$cachedir" -maxdepth 1 -type f -print | wc -l)
    if [[ "$cachecount" -ne 0 ]]; then
        print "# of cache files found: $cachecount"
        print "Purging FusionPBX cache files"
        find "$cachedir" -type f -print -delete
        print "Cache purge was successful!"
    fi
    
    print "Reloading FreeSWITCH xml configuration"
    fs_cli -x 'reloadxml' &>/dev/null

    print "Reloading FreeSWITCH acl configuration"
    fs_cli -x 'reloadacl' &>/dev/null

    print "FreeSWITCH reload complete!"
}

# perm: View guest calling permissions from PTCE database
perm() {
    if [[ ! -f "$HOME/documents/ptce.cnf" ]]; then
        printf "ptce.cnf file not found! Exiting! Create my.cnf file for Parallax with function: mycnf\n"
        return 1
    fi
    printf "View guest calling permissions\n"
    if [ ! -n "$1" ]; then
        printf "0: Cash Permission\n"
        printf "1: Credit Permission\n"
        read -rk1 "permission?Select permission [0/1]: "
    else
        permission=$1
    fi

    case "$permission" in
        0) hr=cash   ;;
        1) hr=credit ;;
        *)
            printf "\n\nInvalid entry! Default to cash permission (0)\n"
            permission=0
            hr=cash
        ;;
    esac

    printf "\nViewing guest extensions with $hr calling permission\n"
    sql="SELECT stationno FROM stationtable WHERE permtollfree = 1 AND permlongdist = $permission"
    sleep 1
    mysql --defaults-extra-file=$HOME/documents/ptce.cnf ptceDB -BNe "$sql"
}

