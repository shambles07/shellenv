# create_homedirs: create home directory layout
create_homedirs() {
    docs="$HOME/documents"
    dirs=(
        "$docs/backup"
        "$docs/config"
        "$docs/logs/pcap"
        "$docs/logs/postinstall"
        "$docs/scripts/bash"
    )
    for i in ${dirs[@]}
    do
        if [ ! -d "$i" ]; then
            print "Creating directory $i"
            mkdir -p "$i"
        fi
    done
    dl="$HOME/downloads"
    dl_dirs=(
        "$dl/build"
        "$dl/pkg"
    )
    if which yum &>/dev/null || which dnf &>/dev/null
    then
        dl_dirs+=("$dl/rpm")
    else
        dl_dirs+=("$dl/deb")
    fi
    for i in ${dl_dirs[@]}
    do
        if [ ! -d "$i" ]; then
            print "Creating directory $i"
            mkdir -p "$i"
        fi
    done
}

# mycnf: generate custom my.cnf file for frequency/parallax
# also adds the aliases "my" and "myd" for mysql / mysqldump
mycnf() {
    local hostname cnf db pass MAJOR_VERSION ANS
    hostname="$(hostname -s)"
    cnf="$HOME/documents/$hostname.cnf"
    printf "\nCreating file %s for automated mysql authentication\n\n" "$cnf"
    if [ -f "$cnf" ]; then
        printf "File %s already exists.\n" "$cnf"
        read -q "ANS?Continue? File will be overwritten! [y/n] "
        printf "\n"
        if [[ ! "$ANS" =~ [yY] ]]; then
            return 0
        fi
    fi
    case "$hostname" in
        fre[eq]*)
            db=asterisk
            pass=REDACTED
        ;;
        ptce*)
            db=ptceDB
            # check parallax version using same version used by /ptce/bin/ptce
            MAJOR_VERSION=$(grep -Po '(?<=PTCE_VERSION_NUMBER=)(.*)' /ptce/config/ptceproperties.config | cut -d' ' -f1 | cut -d. -f1 | cut -d'v' -f1)
            if [[ "$MAJOR_VERSION" -ge 17 ]]; then
                pass=REDACTED
            else
                pass=REDACTED
            fi
        ;;
        # unable to check version
        *)
            print "Hostname does not match the standard Frequency/Parallax format, unable to automatically set password"
            read "pass?Input MySQL db password: "
        ;;
    esac
    if [ -z "$db" ]; then
        read "db?Input MySQL db name: "
    fi
    ( umask 077; cat > "$cnf" ) << EOF
[client]
user=percipia
password=${pass}

[mysql]
user=percipia
password=${pass}
database=${db}
pager=less -SFX

[mysqldump]
user=percipia
password=${pass}
database=${db}
no-create-info
hex-blob
compact
skip-extended-insert
EOF
    # ! grep -q 'alias my='  ~/.zsh_aliases && sed -i '/alias my=/d'  ~/.zsh_aliases
    # ! grep -q 'alias myd=' ~/.zsh_aliases && sed -i '/alias myd=/d' ~/.zsh_aliases
    # printf "alias my='mysql --defaults-extra-file=\$HOME/documents/%s.cnf %s'\n" "$hostname" "$db" >> ~/.zsh_aliases
    # printf "alias myd='mysqldump --defaults-extra-file=%s %s'\n" "$cnf" "$db" >> ~/.zsh_aliases
    # printf "\naliases \"my\", \"myd\" added to ~/.zsh_aliases\n"
    # printf "File %s created!\n\n" "$cnf"
    # source ~/.zsh_aliases

    chmod 600 "$cnf"
    # (re)load aliases so my/myd pick up the new file
    source "$SHELLENV/.zsh_aliases"
	# view aliases
    alias my
    alias myd
}

