# reg: View FreeSWITCH registration details
reg() {
	reginfo=$(fs_cli -x 'show registrations' | cut -d/ -f3 | cut -d: -f2 | head -n-3 | tail -n+2)
	ipaddr=$(cut -d@ -f2 <<< "$reginfo")
	if [[ "${#reginfo}" -eq 0 ]]; then
        return 1
	fi
	exten=$(cut -d@ -f1 <<< "$reginfo")
	printf "%s: %s\n" "$exten" "$ipaddr"
}

# reg: View all registered FreeSWITCH extensions sorted by IP address
regall() {
	fs_cli -x 'show registrations' \
        | cut -d/ -f3 \
        | cut -d: -f2 \
        | head -n-3 \
        | tail -n+2 \
        | tr '@' ' ' \
        | sort -Vk2 \
        | awk '{ printf "%s@%s\n", $1, $2 }'
}

# srp: Print registration details for FreeSWITCH extension
srp() {
	registered=$(fs_cli -x "show registrations" | grep \^$1)
	if [[ "$2" =~ \-p ]]; then
		( cut -d@ -f3 | cut -d: -f1 ) <<< "$registered"
	else
		printf "%s\n" "$registered" | grep \^$1 <<< "$registered"
	fi
}

# sr: Print FreeSWITCH extension registrations
