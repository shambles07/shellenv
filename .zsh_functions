# sqlad: Run mysqladmin commands
sqlad() {
    # Verify mysql is installed
    if ! which mysql >/dev/null 2>&1; then
        printf "Requires MySQL, which is not found!\n"
        return 1
    fi
    cnf_file=( $(find $HOME/documents -type f -name "*.cnf") )
    if [[ "${#cnf_file[@]}" -gt 1 ]]; then
        printf "Multiple .cnf files found!\n"
        PS3="Select my.cnf file: "
        select arg in "${cnf_file[@]}"
        do
            printf "%scnf file selected: %s%s\n" "$(tput setaf 2)" "$arg" "$(tput sgr0)"
            file="$arg"
            break
        done
    elif [[ "${#cnf_file[@]}" -eq 0 ]]; then
        printf "Unable to find my.cnf file! Run mycnf to generate one!\n"
        return 1
    else
        file="${cnf_file[0]}"
    fi
    mysqladmin --defaults-extra-file="$file" "$@"
}

