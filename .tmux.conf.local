# : << 'EOF'
# Oh my tmux! local customizations
#
# Loads the upstream .tmux.conf.local template straight from the .tmux
# submodule (so it stays current with updates), then applies only the
# settings below. Override any tmux_conf_* variable from the template here.
#
# The `# : << 'EOF'` first line and the `# EOF` / `# "$@"` lines at the bottom
# are required: Oh my tmux! also parses this file as a shell script.


# -- upstream defaults ---------------------------------------------------------

# pass 1: source the upstream template, then this file again (pass 2) so the
# settings below take precedence. Both run as one command chain because a plain
# `run ... source` finishes asynchronously, after the rest of this file.
# The repo is found from the ~/.tmux.conf.local link; plain `readlink` is the
# fallback for macOS before 12.3, which has no `readlink -f`.
%if #{==:#{@shellenv_pass2},}
run '"$TMUX_PROGRAM" -S "#{socket_path}" set -g @shellenv_pass2 1 \; source "$(dirname "$(readlink -f "$TMUX_CONF_LOCAL" 2>/dev/null || readlink "$TMUX_CONF_LOCAL" || echo "$TMUX_CONF_LOCAL")")/.tmux/.tmux.conf.local" \; source "$TMUX_CONF_LOCAL" \; set -gu @shellenv_pass2'
%else


# -- theme ---------------------------------------------------------------------

# window status: 🔔 for bell, 🔍 for zoomed
tmux_conf_theme_window_status_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,🔔,}#{?window_zoomed_flag,🔍,}"
tmux_conf_theme_window_status_current_format="#I #W#{?#{||:#{window_bell_flag},#{window_zoomed_flag}}, ,}#{?window_bell_flag,🔔,}#{?window_zoomed_flag,🔍,}"


# -- general -------------------------------------------------------------------

# default shell: zsh when installed, otherwise bash
run '"$TMUX_PROGRAM" -S "#{socket_path}" set -g default-shell "$(command -v zsh || command -v bash || echo /bin/sh)"'

# only use C-b as prefix (drop the GNU-Screen compatible C-a)
set -gu prefix2
unbind C-a


# -- bindings ------------------------------------------------------------------

# kill bindings
bind X kill-pane                          #!important
bind k kill-window                        #!important

# no-prefix navigation
#   Shift+arrows (and Shift+Opt+Left/Right) are taken by iTerm2 key bindings,
#   so these use Option and Control+Shift instead.
#   Note: Option+Left/Right no longer do word jumps in the shell inside tmux.
#   Opt+arrows             select pane
#   Ctrl+Shift+Left/Right  previous/next window   (also Ctrl+Shift+H/L)
#   Ctrl+Shift+J/K         select pane below/above
#   Ctrl+Shift+Up/Down     previous/next session
bind -n M-Left  select-pane -L
bind -n M-Right select-pane -R
bind -n M-Down  select-pane -D
bind -n M-Up    select-pane -U

bind -n C-S-Left  previous-window
bind -n C-S-Right next-window
bind -n C-S-H     previous-window
bind -n C-S-L     next-window
bind -n C-S-J     select-pane -D
bind -n C-S-K     select-pane -U

bind -n C-S-Up    switch-client -p
bind -n C-S-Down  switch-client -n

%endif


# -- custom variables ----------------------------------------------------------

# define POSIX shell functions for custom #{foo} variables between the
# '# EOF' and the '# "$@"' lines, see the upstream template for examples

# /!\ do not remove the following line
# EOF
#
# "$@"
# # /!\ do not remove the previous line
# #     do not write below this line
